# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API
ANTHROPIC_API_KEY=
# Only required if your key is a multi-workspace personal key (Console ->
# Settings -> Workspaces -> copy the wrkspc_... id). Leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# Gmail OAuth (cloud component). Obtained via Google Cloud Console -> OAuth client (Desktop app).
# Path to the downloaded OAuth client secret JSON (see README "Authorizing Gmail").
GMAIL_CLIENT_SECRET_FILE=credentials/gmail_client_secret.json
# Where the authorized user token is cached after the first interactive login. Gitignored.
GMAIL_TOKEN_FILE=credentials/gmail_token.json
# The Gmail address this tool sends notifications to/from (your inbox).
GMAIL_USER_EMAIL=

# Your identity, used for cover letter signatures and resume-owner fields.
APPLICANT_NAME="Kirill Kuznetsov"
# Used to fill phone fields on application forms (LinkedIn Easy Apply,
# Greenhouse, etc.). Leave blank to have the local agent stop and ask
# instead of guessing.
APPLICANT_PHONE=

# SQLite datastore shared by the cloud and local components.
JOBFINDER_DB_PATH=data/jobfinder.db

# Local component only: path to a persistent Chrome user-data-dir seeded with your logins.
CHROME_USER_DATA_DIR=chrome-profile/

# Daily cap on total automated applications (local component pacing).
DAILY_APPLICATION_CAP=15

# Tier-1 local classifier (optional, see README "Tier-1 local classifier").
# Kill-switch: off by default, so behavior is unchanged until a model file
# exists AND this is set to true.
TIER1_MODEL_ENABLED=false
TIER1_CONFIDENCE_MIN=0.85
TIER1_AGREEMENT_CHECK_RATE=0.1
TIER1_MODEL_PATH=models/tier1_classifier.q4_k_m.gguf

