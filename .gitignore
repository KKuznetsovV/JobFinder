# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets & local config
.env
credentials/*.json
!credentials/.gitkeep
token.json
gmail_token.json
*.token.json

# Runtime data (never commit real application data)
data/*.db
data/*.sqlite3
data/*.sqlite3-journal
storage_state.json
chrome-profile/

# Real resumes (user-provided, not sample/fixture data)
resumes/*.docx
!resumes/.gitkeep

# Tier-1 classifier training artifacts: generated data, model checkpoints,
# merged weights, and GGUF exports are all large/reproducible - never commit.
models/
scripts/tier1/data/
scripts/tier1/output/
unsloth_compiled_cache/

# Logs
*.log
logs/

# OS/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
